TOURFLOW_DATABASE_URL=postgresql://postgres:your-password@localhost:5432/tourflow
TOURFLOW_SUPABASE_URL=https://your-project.supabase.co
# Required only for legacy HS256 Supabase JWTs; prefer the Supabase JWKS flow.
TOURFLOW_SUPABASE_JWT_SECRET=

# Server-side AI trip planner configuration.
TOURFLOW_AI_API_KEY=
TOURFLOW_AI_BASE_URL=https://api.groq.com/openai/v1
TOURFLOW_AI_MODEL=openai/gpt-oss-120b
TOURFLOW_AI_TIMEOUT_SECONDS=20

# Optional web-search and flight APIs for the AI trip planner.
TOURFLOW_SEARCH_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

TOURFLOW_CORS_ORIGINS=http://localhost:3000
TOURFLOW_AUTO_CREATE_SCHEMA=false
